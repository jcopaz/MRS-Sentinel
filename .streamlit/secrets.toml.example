[supabase]
url         = "https://SEU_PROJETO.supabase.co"
key         = "eyJhbGc..."       # Anon/Public Key
service_key = "eyJhbGc..."       # Service Role Key ⚠️ acesso admin total, ignora RLS — nunca comitar

[app]
nome     = "MRS Sentinel"
versao   = "1.0.0"
ambiente = "desenvolvimento"

# E-mail de reset de senha (SMTP puro) — auth/recuperar_senha.py, canal
# SECUNDÁRIO desde 2026-09-11 (SMS é o primário, ver [brevo] abaixo).
[smtp]
host      = "smtp-relay.brevo.com"
port      = 587
usuario   = "SEU_LOGIN_SMTP_BREVO"
senha     = "SUA_CHAVE_SMTP_BREVO"
remetente = "no-reply@SEU-DOMINIO"

# SMS de reset de senha (API HTTP do Brevo) — integracoes/brevo.py, canal
# PRIMÁRIO desde 2026-09-11. api_key é a chave REST (Transactional SMS),
# DIFERENTE da chave SMTP acima.
[brevo]
api_key    = "xkeysib-..."
sms_sender = "MRSSentin"   # até 11 caracteres alfanuméricos (padrão GSM)
